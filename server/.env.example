# Queries run over this. On Neon use the POOLED string (host contains "-pooler").
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/onion_vod?schema=public"
# Migrations run over this - poolers cannot run them. On Neon use the DIRECT
# string. Locally it is the same database.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/onion_vod?schema=public"
PORT=5000
JWT_SECRET="change_me"

# Extra browser origins allowed to call this API, comma separated. The
# allowlist is enforced when NODE_ENV=production, so the deployed frontend
# domain MUST be listed here or it will be blocked from its own API.
CORS_ORIGINS=

# --- TMDB (movie/TV metadata) ---
# Get a key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=
TMDB_BASE_URL="https://api.themoviedb.org/3"

# --- Video hosting/streaming ---
# Set to "cloudflare" or "jwplayer" once you've picked a provider, then fill
# in the matching keys below. Leave blank to keep using the DB-stored
# playbackUrl as-is (current behavior, unaffected until VIDEO_PROVIDER is set).
VIDEO_PROVIDER=

# Cloudflare Stream — https://developers.cloudflare.com/stream/
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=

# JW Player — https://developer.jwplayer.com/jwplayer/docs
JWPLAYER_API_KEY=
JWPLAYER_API_SECRET=

# --- Music source ---
# /music/* reads from YouTube, through InnerTube — no key and no quota. There
# is nothing to configure and nothing to choose: the second source and the
# MUSIC_SOURCE selector that picked between them were both removed. See
# server/src/services/youtube.js.

# Seeds the music home row when YouTube's own home feed is unavailable.
YOUTUBE_TRENDING_QUERY=

# Where the InnerTube session (YouTube's player script and the signature
# functions extracted from it) is cached between restarts. Optional.
YOUTUBE_CACHE_DIR=

# Where the InnerTube session is cached between restarts.
YOUTUBE_CACHE_DIR=
